meta {
  name: POST /refresh-token
  type: http
  seq: 2
}

post {
  url: {{url}}/auth/refresh-token
  body: json
  auth: inherit
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

vars:pre-request {
  username: oddert@gmail.com
  password: Bugatt1rulesoK
}

script:post-response {
  if (res.body.payload.accessToken) {
    bru.setEnvVar("accessToken", res.body.payload.accessToken)
    bru.setEnvVar("refreshToken", res.body.payload.refreshToken)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
