meta {
  name: Create Credit
  type: http
  seq: 2
}

post {
  url: {{url}}/card
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "bankName": "Tesco Bank",
    "cardName": "Credit card",
    "cardType": "CREDIT",
    "sortCode": 654321
  }
}

script:post-response {
  if (res.body.payload && res.body.payload.card) {
    bru.setEnvVar("cardCreditId", res.body.payload.card.id)
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
